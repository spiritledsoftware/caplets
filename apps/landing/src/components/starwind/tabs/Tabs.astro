---
import type { HTMLAttributes } from "astro/types";

import { tabs } from "./variants";

interface Props extends HTMLAttributes<"div"> {
  defaultValue?: string;
  syncKey?: string;
}

const { defaultValue, syncKey, class: className, ...rest } = Astro.props;
---

<div
  class={tabs({ class: className })}
  data-default-value={defaultValue}
  data-sync-key={syncKey}
  {...rest}
  data-slot="tabs"
>
  <slot />
</div>

<script>
  import { initializeStarwindTabs } from "./tabs-client";

  initializeStarwindTabs();
  document.addEventListener("astro:after-swap", () => initializeStarwindTabs());
  document.addEventListener("starwind:init", () => initializeStarwindTabs());
</script>
