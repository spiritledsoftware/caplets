---
import { portabilitySurfaces } from "../../data/landing";
---

<section class="mx-auto w-[min(1180px,calc(100vw_-_32px))] scroll-mt-20 py-20" id="portable" aria-labelledby="remote-story-title" data-reveal>
  <div class="grid gap-10 lg:grid-cols-[0.88fr_1.12fr] lg:items-start [&>*]:min-w-0">
    <div class="max-w-xl">
      <p class="text-sm font-medium text-muted-foreground">Reuse across agents and teams</p>
      <h2 id="remote-story-title" class="mt-3 text-3xl leading-tight font-semibold tracking-[-0.02em] text-balance md:text-5xl">
        Configure once. Reuse anywhere Caplets is supported.
      </h2>
      <p class="mt-5 text-lg leading-8 text-pretty text-muted-foreground">
        The Caplet definition travels. Credentials and authorization stay with each host.
      </p>
      <a class="mt-6 inline-flex min-h-11 items-center font-medium text-primary-accent hover:underline focus-visible:ring-3 focus-visible:ring-outline/50 focus-visible:outline-none" href="https://docs.caplets.dev/capabilities/">Create and share a Caplet</a>
    </div>

    <dl class="divide-y divide-border border-y border-border" aria-label="Supported agent surfaces">
      {portabilitySurfaces.map((surface) => (
        <div class="grid gap-1 py-4 sm:grid-cols-[10rem_minmax(0,1fr)] sm:items-baseline sm:gap-6">
          <dt class="text-sm text-muted-foreground">{surface.label}</dt>
          <dd class="font-semibold text-foreground">{surface.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
