---
const workStages = [
  { system: "Linear", action: "Read the issue", outcome: "requirements" },
  { system: "GitHub", action: "Inspect and change code", outcome: "pull request" },
  { system: "CI", action: "Check the build", outcome: "verified change" },
  { system: "Deploy", action: "Release when authorized", outcome: "production" },
  { system: "Status", action: "Report the result", outcome: "closed loop" },
] as const;
---

<section class="border-y border-border bg-card/35" id="work" aria-labelledby="whole-job-title" data-reveal>
  <div class="mx-auto grid w-[min(1180px,calc(100vw_-_32px))] gap-10 py-20 lg:grid-cols-[0.68fr_1.32fr] lg:items-start [&>*]:min-w-0">
    <div class="max-w-xl">
      <p class="text-sm font-medium text-muted-foreground">Issue to production</p>
      <h2 id="whole-job-title" class="mt-3 text-3xl leading-tight font-semibold tracking-[-0.02em] text-balance md:text-5xl">
        Let the agent carry the whole job.
      </h2>
      <p class="mt-5 text-lg leading-8 text-pretty text-muted-foreground">
        Follow one illustrative route across issue tracking, source control, CI, deployment, and status instead of carrying every handoff yourself.
      </p>
      <p class="mt-5 text-sm leading-6 text-muted-foreground">
        Every step runs only when its capability has been exposed and authorized. Caplets does not grant autonomous deployment authority.
      </p>
    </div>

    <ol class="min-w-0 overflow-hidden rounded-lg border border-border bg-background" aria-label="Illustrative issue-to-production route">
      {workStages.map((stage, index) => (
        <li class="grid min-w-0 gap-3 border-b border-border p-4 last:border-b-0 sm:grid-cols-[2.5rem_7rem_minmax(0,1fr)_auto] sm:items-center md:p-5">
          <span class="font-mono text-xs text-muted-foreground" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          <strong class="font-mono text-sm text-foreground">{stage.system}</strong>
          <span class="text-sm text-muted-foreground">{stage.action}</span>
          <span class="w-fit rounded-full border border-border bg-card px-2.5 py-1 text-xs font-medium text-foreground">{stage.outcome}</span>
        </li>
      ))}
    </ol>
  </div>
</section>
