---
import Lock from "@tabler/icons/outline/lock.svg";

const workStages = [
  { system: "Linear", action: "Read issue", outcome: "requirements" },
  { system: "GitHub", action: "Change code", outcome: "pull request" },
  { system: "CI", action: "Check build", outcome: "verified" },
  { system: "Deploy", action: "Release", outcome: "production" },
  { system: "Status", action: "Report", outcome: "closed loop" },
] as const;
---

<section class="scroll-mt-20 border-y border-border bg-card/35" id="work" aria-labelledby="whole-job-title" data-reveal>
  <div class="mx-auto w-[min(1180px,calc(100vw_-_32px))] py-16 md:py-20">
    <div class="grid gap-6 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
      <h2 id="whole-job-title" class="max-w-[13ch] text-3xl leading-tight font-semibold tracking-[-0.02em] text-balance md:text-5xl">
        One agent. The whole job.
      </h2>
      <p class="max-w-2xl text-lg leading-8 text-pretty text-muted-foreground">
        Move one change from issue to production without carrying every handoff yourself.
      </p>
    </div>

    <ol class="relative mt-12 grid gap-7 md:grid-cols-5 md:gap-4" aria-label="Illustrative issue-to-production route">
      <span class="absolute top-6 right-[10%] left-[10%] hidden h-px bg-border md:block" aria-hidden="true"></span>
      {workStages.map((stage, index) => (
        <li class="relative grid grid-cols-[3rem_minmax(0,1fr)] gap-4 md:block">
          <span class="relative z-10 grid size-12 place-items-center rounded-full border border-border bg-background font-mono text-xs font-semibold text-primary-accent shadow-[0_10px_28px_oklch(0%_0_0_/_0.18)]" aria-hidden="true">
            {String(index + 1).padStart(2, "0")}
          </span>
          <div class="pb-1 md:mt-5">
            <strong class="font-mono text-sm text-foreground">{stage.system}</strong>
            <span class="mt-1 block text-sm text-muted-foreground">{stage.action}</span>
            <span class="mt-3 block font-mono text-xs text-primary-accent">{stage.outcome}</span>
          </div>
        </li>
      ))}
    </ol>

    <div class="mt-10 flex max-w-2xl items-start gap-3 border-t border-border pt-5 text-sm leading-6 text-muted-foreground">
      <Lock class="mt-1 size-4 shrink-0 text-primary-accent" aria-hidden="true" />
      <p>Each step runs only after you expose and authorize that capability.</p>
    </div>
  </div>
</section>
