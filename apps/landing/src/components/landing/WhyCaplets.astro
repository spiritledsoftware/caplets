---
import Route from "@tabler/icons/outline/route.svg";

import { whyCapletsProblems } from "../../data/landing";
---

<section class="mx-auto w-[min(1180px,calc(100vw_-_32px))] scroll-mt-20 py-20" id="why" aria-labelledby="why-caplets-title" data-reveal>
  <div class="grid gap-8 lg:grid-cols-[0.72fr_1.28fr] lg:items-start [&>*]:min-w-0">
    <div class="min-w-0 max-w-xl">
      <p class="text-sm font-medium text-muted-foreground">The missing connection</p>
      <h2 id="why-caplets-title" class="mt-3 text-3xl leading-tight font-semibold tracking-[-0.02em] text-balance md:text-5xl">
        Stop being your agent's human integration layer.
      </h2>
      <p class="mt-5 text-lg leading-8 text-pretty text-muted-foreground">
        Your agent can change the code. You still copy the issue, inspect the dashboard, trigger the operation, and update the status.
      </p>
      <p class="mt-4 text-lg leading-8 text-pretty text-muted-foreground">
        Caplets gives it controlled capabilities across those systems while preserving the exact access, schemas, results, and errors each backend provides.
      </p>
    </div>

    <div class="min-w-0 rounded-lg border border-border bg-card/82">
      <div class="hidden grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center border-b border-border px-4 py-3 text-sm font-medium text-muted-foreground md:grid">
        <span>Without a capability layer</span>
        <Route class="size-4 text-primary-accent" aria-hidden="true" />
        <span class="text-right">With Caplets</span>
      </div>
      <div class="divide-y divide-border">
        {
          whyCapletsProblems.map((item) => (
            <div class="grid gap-4 px-4 py-5 md:grid-cols-[minmax(0,0.88fr)_auto_minmax(0,1fr)] md:items-start">
              <div class="min-w-0">
                <p class="mb-2 text-xs font-medium text-muted-foreground md:hidden">Without a capability layer</p>
                <h3 class="font-semibold text-foreground">{item.label}</h3>
                <p class="mt-2 text-sm leading-6 text-muted-foreground">{item.before}</p>
              </div>
              <div class="hidden h-full w-px bg-border md:block" aria-hidden="true"></div>
              <div class="min-w-0">
                <p class="mb-2 text-xs font-medium text-muted-foreground md:hidden">With Caplets</p>
                <p class="text-sm leading-6 text-foreground md:pt-8">{item.after}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
