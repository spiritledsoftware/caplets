---
import Lock from "@tabler/icons/outline/lock.svg";

import { Button } from "@/components/starwind/button";
---

<section class="landing-hero relative isolate w-full scroll-mt-20 overflow-hidden border-y border-border/70 py-16 md:py-24 lg:py-28" id="trace" aria-labelledby="hero-title">
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_72%_28%,transparent_0,oklch(15%_0.014_100_/_0.1)_34rem),linear-gradient(90deg,oklch(12%_0.014_100_/_0.96)_0%,oklch(12%_0.014_100_/_0.86)_36%,oklch(12%_0.014_100_/_0.3)_68%,oklch(12%_0.014_100_/_0.18)_100%)]"></div>

  <div class="relative mx-auto w-[min(1180px,calc(100vw_-_32px))]">
    <div class="max-w-3xl">
      <h1 id="hero-title" class="landing-hero__title max-w-[13ch] text-4xl leading-[0.98] font-semibold tracking-[-0.03em] text-balance text-[oklch(96%_0.02_82)] sm:text-5xl sm:leading-[0.95] md:text-6xl">
        Give your coding agent the whole stack.
      </h1>
      <p class="landing-hero__summary mt-6 max-w-xl text-lg leading-8 text-pretty text-[oklch(88%_0.026_82)]">
        Package MCP servers, APIs, and commands as focused Caplets. Your agent opens only what each task needs.
      </p>

      <div class="landing-hero__actions mt-8 flex flex-wrap gap-3" role="group" aria-label="Primary actions">
        <Button href="#install" variant="primary" data-cta-category="primary">Connect your first capability</Button>
        <Button href="https://catalog.caplets.dev" variant="outline" data-cta-category="secondary">Browse shared Caplets</Button>
      </div>

      <div class="mt-6 inline-flex items-center gap-2 text-sm text-[oklch(80%_0.028_82)]">
        <Lock class="size-4 shrink-0 text-[oklch(82%_0.08_45)]" aria-hidden="true" />
        <span>You choose every capability and credential boundary.</span>
      </div>
    </div>
  </div>
</section>
