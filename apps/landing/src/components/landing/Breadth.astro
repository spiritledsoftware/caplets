---
const backendFamilies = [
  ["MCP", "Wrap any supported MCP server"],
  ["OpenAPI", "Turn a specification into typed operations"],
  ["Google Discovery", "Connect Google APIs from discovery documents"],
  ["GraphQL", "Expose schema-driven queries and mutations"],
  ["HTTP", "Define focused actions for a simple endpoint"],
  ["CLI", "Select the repository commands an agent may run"],
  ["Caplet Files", "Reuse a capability definition someone has shared"],
] as const;

const agentSurfaces = [
  ["Codex", "MCP"],
  ["Claude", "MCP"],
  ["OpenCode", "Native · MCP"],
  ["Pi", "Native · MCP"],
  ["Supported remote clients", "Remote Attach"],
] as const;
---

<section class="mx-auto w-[min(1180px,calc(100vw_-_32px))] scroll-mt-20 py-20" id="breadth" aria-labelledby="breadth-title" data-reveal>
  <div class="grid gap-8 lg:grid-cols-[0.82fr_1.18fr] lg:items-end [&>*]:min-w-0">
    <div class="max-w-xl">
      <p class="text-sm font-medium text-primary-accent">What you can connect</p>
      <h2 id="breadth-title" class="mt-3 text-3xl leading-tight font-semibold tracking-[-0.02em] text-balance md:text-5xl">
        MCP. APIs. Commands. All of it.
      </h2>
    </div>
    <p class="max-w-2xl text-lg leading-8 text-pretty text-muted-foreground">
      Connect a backend through any supported interface below. Each Caplet packages one focused capability. The catalog is optional—not a limit on what you can connect.
    </p>
  </div>

  <div class="mt-10 grid min-w-0 gap-px overflow-hidden rounded-lg border border-border bg-border lg:grid-cols-[1.1fr_0.72fr_0.9fr]" role="group" aria-label="Backend-to-agent capability map">
    <div class="min-w-0 bg-card p-5 md:p-7">
      <p class="text-sm font-medium text-muted-foreground">Connect a backend</p>
      <dl class="mt-5 divide-y divide-border">
        {backendFamilies.map(([name, detail]) => (
          <div class="grid gap-1 py-3 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-4">
            <dt class="font-mono text-sm font-semibold text-foreground">{name}</dt>
            <dd class="text-sm leading-6 text-muted-foreground">{detail}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="grid min-w-0 place-content-center bg-foreground p-7 text-center text-background">
      <span class="font-mono text-xs font-semibold tracking-[0.08em] text-background/65">CAPABILITY LAYER</span>
      <strong class="mt-4 text-3xl tracking-[-0.02em]">Reusable Caplet</strong>
      <span class="mt-3 max-w-[22ch] text-sm leading-6 text-background/70">One focused backend capability, ready for an agent</span>
    </div>

    <div class="min-w-0 bg-card p-5 md:p-7">
      <p class="text-sm font-medium text-muted-foreground">Use it through a supported agent surface</p>
      <ul class="mt-5 divide-y divide-border">
        {agentSurfaces.map(([agent, surface]) => (
          <li class="flex items-center justify-between gap-3 py-3">
            <span class="font-semibold text-foreground">{agent}</span>
            <span class="font-mono text-xs text-muted-foreground">{surface}</span>
          </li>
        ))}
      </ul>
      <p class="mt-5 text-sm leading-6 text-muted-foreground">The surface changes by client. The Caplet definition remains reusable; every host authorizes its own credentials and access.</p>
    </div>
  </div>
</section>
